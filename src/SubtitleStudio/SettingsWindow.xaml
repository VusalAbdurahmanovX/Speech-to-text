<Window x:Class="SubtitleStudio.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings | Speech to Text" Width="900" Height="800" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F2F5F9" Foreground="#19283E" Closing="WindowClosing">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
   <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#69788D"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
   <Style TargetType="TabItem"><Setter Property="Padding" Value="22,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White"/><Setter TargetName="TabSurface" Property="TextElement.Foreground" Value="#2361D8"/><Setter TargetName="TabSurface" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#2361D8"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary>
 </Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Your transcription preferences, tools, and performance." Foreground="#69788D" Margin="0,5,0,0"/></StackPanel>
  <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16" Margin="0,18,0,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel download" Click="CancelOperation" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="CloseButton" Content="Close" Click="CloseSettings" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Save changes" Click="SaveSettings" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StatusLabel" Text="Changes apply when you save." Foreground="#69788D" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel><ProgressBar x:Name="OperationProgress" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#2361D8"/></StackPanel></Border>
  <TabControl x:Name="SettingsTabs" BorderThickness="0" Background="Transparent">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#E5EBF4" CornerRadius="9" Padding="4"><TabPanel IsItemsHost="True"/></Border><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Transcription" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the spoken language and the model used for new transcripts." Style="{StaticResource Hint}" Margin="0,0,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Language code" Margin="0,0,0,7"/><ComboBox x:Name="LanguageBox" IsEditable="True" AutomationProperties.Name="Language code"/><TextBlock Text="tr = Turkish, az = Azerbaijani, auto = detect" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Whisper model" Margin="0,0,0,7"/><ComboBox x:Name="ModelBox" SelectionChanged="SelectedModelChanged" AutomationProperties.Name="Whisper model"/><TextBlock x:Name="ModelInfoLabel" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel></Grid>
     <Button x:Name="DownloadButton" Content="Download selected model" Click="DownloadModel" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="12,8"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="Processing backend" Style="{StaticResource SectionTitle}"/><TextBlock Text="Run whisper.cpp on your NVIDIA GPU or explicitly choose the CPU." Style="{StaticResource Hint}" Margin="0,0,0,16"/><WrapPanel><RadioButton x:Name="CudaButton" Content="NVIDIA CUDA" GroupName="Backend" Margin="0,0,30,0"/><RadioButton x:Name="CpuButton" Content="CPU" GroupName="Backend"/></WrapPanel><Border Background="#EDF3FF" CornerRadius="7" Padding="12" Margin="0,16,0,0"><TextBlock Text="CUDA mode verifies the backend with nvidia-smi. If CUDA is unavailable, transcription stops with an error. No automatic CPU fallback." Foreground="#34588E" TextWrapping="Wrap" FontSize="12"/></Border></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Tools &amp; paths"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="One-time setup" Style="{StaticResource SectionTitle}"/><TextBlock Text="Download official CUDA whisper.cpp and FFmpeg. Archives are verified before installation. Your media stays on this PC." Style="{StaticResource Hint}"/><Button x:Name="InstallButton" Content="Install transcription tools" Click="InstallTools" HorizontalAlignment="Left" Margin="0,16,0,0" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="File locations" Style="{StaticResource SectionTitle}"/><TextBlock Text="Use downloaded tools or select your own executables." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
     <TextBlock Text="whisper-cli.exe" Margin="0,0,0,7"/><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseWhisper" Padding="12,8" Margin="8,0,0,0"/><TextBox x:Name="WhisperPathBox" AutomationProperties.Name="whisper.cpp executable path"/></DockPanel>
     <TextBlock Text="FFmpeg" Margin="0,0,0,7"/><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseFFmpeg" Padding="12,8" Margin="8,0,0,0"/><TextBox x:Name="FFmpegPathBox" AutomationProperties.Name="FFmpeg path"/></DockPanel>
     <TextBlock Text="Model folder" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseModels" Padding="12,8" Margin="8,0,0,0"/><TextBox x:Name="ModelFolderBox" TextChanged="ModelFolderChanged" AutomationProperties.Name="Model folder"/></DockPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Performance" Style="{StaticResource SectionTitle}"/><TextBlock Text="Defaults work well for most recordings. Higher beam sizes can take longer." Style="{StaticResource Hint}" Margin="0,0,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Beam size" Margin="0,0,0,7"/><TextBox x:Name="BeamBox" AutomationProperties.Name="Beam size"/><TextBlock Text="1-100" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CPU threads" Margin="0,0,0,7"/><TextBox x:Name="ThreadsBox" AutomationProperties.Name="Thread count"/><TextBlock Text="1-256" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="GPU layers" Margin="0,0,0,7"/><TextBox x:Name="LayersBox" AutomationProperties.Name="GPU layer count"/><TextBlock Text="1-999" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel></Grid><TextBlock Text="GPU layers are passed only if your whisper.cpp --help supports this option. Stock builds manage CUDA offload automatically." Style="{StaticResource Hint}" Margin="0,18,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="Benchmark" Style="{StaticResource SectionTitle}"/><TextBlock Text="Measure transcription speed, realtime factor, and verified backend using sample_1min.mp3 in the application root." Style="{StaticResource Hint}"/><Button Content="Run benchmark" Click="Benchmark" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
