<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.5</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>Speech to Text</Product>
    <Authors>Vusal Abdurahmanov</Authors>
    <Description>Local Windows transcription powered by official whisper.cpp.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png"/>
    <Resource Include="Assets\AppIcon.ico"/>
  </ItemGroup>
</Project>
